{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pos-horeca",
  "version": "0.1.0",
  "identifier": "com.georgi-paunkov.pos-horeca",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pos-horeca",
        "decorations": false,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
